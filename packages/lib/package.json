  "description": "Stream a browser camera as MPEG-TS with MISB ST 0601 KLV metadata via a WebTransport/WebSocket-to-UDP relay",
  "type": "module",
  "main": "./dist/web-video-streamer.umd.cjs",
  "module": "./dist/web-video-streamer.js",
