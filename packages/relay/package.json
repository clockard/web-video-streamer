{
  "name": "web-video-streamer-relay",
  "version": "0.1.0",
  "description": "WebTransport and WebSocket to UDP relay for web-video-streamer MPEG-TS streams",
  "license": "MIT",
  "author": "clockard",
  "homepage": "https://github.com/clockard/web-video-streamer#readme",
  "bugs": {
    "url": "https://github.com/clockard/web-video-streamer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clockard/web-video-streamer.git",
    "directory": "packages/relay"
  },
  "keywords": [
    "webtransport",
    "websocket",
    "udp",
    "relay",
    "mpeg-ts",
    "http3",
    "quic"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "web-video-streamer-relay": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@fails-components/webtransport": "^1.6.11",
    "@fails-components/webtransport-transport-http3-quiche": "^1.6.11",
    "@peculiar/x509": "^3.1.0",
    "reflect-metadata": "^0.2.2",
    "ws": "^8.22.0"
  }
}
